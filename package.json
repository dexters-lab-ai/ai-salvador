    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.13",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "vite": "^4.4.9"
  },
  "type": "module",
  "overrides": {
    "@types/react": "18.2.8",
    "@pixi/core": "7.2.4",
