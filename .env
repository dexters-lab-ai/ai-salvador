# Environment
NODE_ENV=production

# App Configuration
VITE_BASE_URL=/
VITE_CONVEX_URL=http://localhost:3210

# Clerk Authentication (optional for local development)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex Configuration
CONVEX_DEPLOYMENT=local

# Twitter API (optional for local development)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_USER_ID=

# Ports
PORT=3000
CONVEX_PORT=3210
DASHBOARD_PORT=6791

# Instance Configuration
INSTANCE_NAME=local-docker

# Convex Admin Key (will be generated)
CONVEX_SELF_HOSTED_ADMIN_KEY=
